# JARVIS configuration. Copy to config/.env only if .env does not exist.
# Values are literal strings; double quotes use JSON escaping. No interpolation.
API_BASE_URL="https://api.openai.com/v1"
API_MODEL=""
API_KEY=""
CHAT_MODE="mock"
ASR_MODE="off"
ASR_MODEL="whisper-1"
TTS_MODE="windows"
TTS_MODEL="tts-1"
TTS_VOICE="alloy"
INPUT_DEVICE=""
OUTPUT_DEVICE=""
SAMPLE_RATE="16000"
MAX_RECORD_SECONDS="60"
REQUEST_TIMEOUT="45"
AUTO_SPEAK="false"
WEATHER_CITY="苏州虎丘区"
AMAP_JS_KEY=""
AMAP_SECURITY_JSCODE=""
AMAP_CITY="苏州"
AMAP_DEFAULT_ORIGIN=""

ASR_BASE_URL=""

ASR_API_KEY=""

WEATHER_ADCODE="320505"

# feature/map-update: display scale; geographic source heights remain unchanged.
MAP_VIEW_METERS="1600"
MAP_HEIGHT_SCALE="16"

# Offline wake: install scripts/install_wake.cmd. Ambient audio stays local.
WAKE_ENABLED="true"
WAKE_TIMEOUT_SECONDS="8"
WAKE_SILENCE_SECONDS="1.0"

# Stream text into a single continuous speech playback pipeline.
CHAT_STREAM="true"

# DeepSeek official endpoints: fast response by default; other providers keep their own defaults.
RESPONSE_MODE="fast"

# Free drawing can use more reasoning while ordinary dialogue stays fast.
VISUAL_RESPONSE_MODE="balanced"
